# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything is ignored except the committed template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local plan documents (see CLAUDE.md "Plan-first workflow")
/plans/*
!/plans/README.md

# internal audits and post-mortems — kept out of the public repo
/audits/

# personal Claude Code settings (per-machine, not shared)
.claude/settings.local.json

/src/generated/prisma
