#!/usr/bin/env bash
# Block direct pushes to main. Open a PR from development (or hotfix/<name>)
# into main. GitHub rejects direct pushes to main even with --no-verify.
set -euo pipefail

protected_ref="refs/heads/main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "$protected_ref" ]]; then
    echo "✗ Direct push to '$protected_ref' is blocked." >&2
    echo "  Open a PR from development (or hotfix/<name>) into main." >&2
    echo "  GitHub rejects direct pushes to main even with --no-verify." >&2
    exit 1
  fi
done

exit 0
