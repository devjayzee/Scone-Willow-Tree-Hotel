#!/usr/bin/env bash
# Block direct pushes to main. Release promotions go through a
# chore/release-YYYY-MM-DD PR from development into main.
# Emergency bypass: git push --no-verify
set -euo pipefail

protected_ref="refs/heads/main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "$protected_ref" ]]; then
    echo "✗ Direct push to '$protected_ref' is blocked." >&2
    echo "  Open a chore/release-YYYY-MM-DD PR from development into main." >&2
    echo "  Emergency bypass: git push --no-verify" >&2
    exit 1
  fi
done

exit 0
