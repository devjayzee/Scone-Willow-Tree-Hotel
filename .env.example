# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# ============================================
# Database Connection — TWO URLs required
# ============================================
#
# - DATABASE_URL — runtime queries. Should point at a POOLED connection
#   in transaction mode (short-lived, high concurrency). The Prisma client
#   uses this via the pg adapter for every runtime query.
#
# - DIRECT_URL — migrations + seed. Must point at a SESSION-mode
#   connection because `prisma migrate` uses pg_advisory_xact_lock,
#   which pgbouncer transaction mode cannot hold across statements.
#
# The app REQUIRES both to be set — deployments that only set
# DATABASE_URL will boot and serve queries fine, then silently fail
# every migration attempt.
#
# --- Local development (your own Postgres) ---
# Both URLs can point to the same local connection.
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_management"
DIRECT_URL="postgresql://user:password@localhost:5432/hotel_management"
#
# --- Supabase (production) ---
# DATABASE_URL → transaction pooler (port 6543)
#   postgresql://postgres.<project>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL → session pooler (port 5432 on the SAME pooler subdomain)
#   postgresql://postgres.<project>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# DO NOT use `db.<project>.supabase.co:5432` for DIRECT_URL on Vercel
# deployments — that legacy endpoint is IPv6-only on Free/Pro tiers,
# and Vercel build environments are IPv4-only. Migrations hang with
# `P1001: Can't reach database server` (see the 2026-08-12 outage in
# audits/session-2026-08-13.md). Use the session pooler above instead
# — same host as DATABASE_URL, different port.

# NextAuth.js Configuration
# Generate a secure secret with: openssl rand -base64 32
# REQUIRED: App will not start without a secure secret
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-base64_32"

# The URL where your app is hosted
# For local development: http://localhost:3000
# For production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Resend (transactional email: password reset + staff invites)
# Create an API key at https://resend.com — EMAIL_FROM must be on a verified domain
# Optional: when unset, emails are logged to the server console instead of sent
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# Upstash Redis (for rate limiting)
# Create a free database at https://console.upstash.com
# Optional: App works without this, but login rate limiting will be disabled
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Optional: Recipient-domain gate for outbound staff-invite emails (#182).
# Comma-separated list of hostnames. When set, POST /api/staffs rejects
# invites whose email domain isn't in the list. Intended for public/demo
# deployments where GM credentials are documented — pairs with the per-user
# 5/hour staff-invite rate limit. Unset → no filtering.
INVITE_DOMAIN_ALLOWLIST=""

# Optional escape hatch for `prisma db seed` against a production database
# (#182). The seed script normally refuses to run when NODE_ENV=production
# because it wipes bookings + rooms and hashes policy-violating demo
# passwords. Set to "1" only for the initial demo-deployment seed.
ALLOW_PROD_SEED=""

# Seed passwords (required by `prisma db seed`). Kept out of source so weak
# demo credentials never land in git history. Pick anything for local dev;
# for a deployed demo choose something you actually want signed-in users to
# use. The seed refuses to run if either is unset.
SEED_MANAGER_PASSWORD=""
SEED_STAFF_PASSWORD=""
