# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# Database Connection
# For local development, use your local PostgreSQL instance
# For production, use your hosted database URL (e.g., Supabase, Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_management"

# NextAuth.js Configuration
# Generate a secure secret with: openssl rand -base64 32
# REQUIRED: App will not start without a secure secret
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-base64_32"

# The URL where your app is hosted
# For local development: http://localhost:3000
# For production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Resend (transactional email: password reset + staff invites)
# Create an API key at https://resend.com — EMAIL_FROM must be on a verified domain
# Optional: when unset, emails are logged to the server console instead of sent
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# Upstash Redis (for rate limiting)
# Create a free database at https://console.upstash.com
# Optional: App works without this, but login rate limiting will be disabled
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Optional: Recipient-domain gate for outbound staff-invite emails (#182).
# Comma-separated list of hostnames. When set, POST /api/staffs rejects
# invites whose email domain isn't in the list. Intended for public/demo
# deployments where GM credentials are documented — pairs with the per-user
# 5/hour staff-invite rate limit. Unset → no filtering.
INVITE_DOMAIN_ALLOWLIST=""

# Optional escape hatch for `prisma db seed` against a production database
# (#182). The seed script normally refuses to run when NODE_ENV=production
# because it wipes bookings + rooms and hashes policy-violating demo
# passwords. Set to "1" only for the initial demo-deployment seed.
ALLOW_PROD_SEED=""
